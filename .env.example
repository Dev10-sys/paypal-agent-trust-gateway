# PayPal Agent Trust Gateway - Environment Configuration
# Copy this file to .env and fill in values as needed.
# The application starts in safe demo/mock mode without any credentials.

# ============================================================
# PayPal Sandbox Credentials (OPTIONAL - for real sandbox testing)
# Create sandbox credentials at: https://developer.paypal.com/developer/applications
# Leave empty to use Mock PayPal Adapter (safe offline mode)
# ============================================================
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ============================================================
# AI Provider (OPTIONAL - for LLM-powered intent parsing and explanations)
# Without a key, Mock AI provider is used (deterministic pattern matching)
# ============================================================
# Option A: Google Gemini
GEMINI_API_KEY=

# Option B: OpenAI
OPENAI_API_KEY=

# ============================================================
# Server Configuration (optional - defaults shown)
# ============================================================
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Path for the SQLite operation ledger (defaults to in-memory :memory:)
# Set a file path for persistence across restarts:
# LEDGER_DB_PATH=./data/gateway.db
LEDGER_DB_PATH=

# ============================================================
# NEVER SET IN THIS FILE:
# - Production PayPal credentials
# - Real buyer card/bank information
# - Any key from the PayPal production dashboard
# ============================================================
